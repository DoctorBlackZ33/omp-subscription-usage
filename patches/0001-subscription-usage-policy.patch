@@ -0,0 +1,71 @@
+/**
+ * Local subscription-usage policy denial.
+ *
+ * This is a deliberate, terminal local stop for background/subagent inference:
+ * it is not a provider response, not a missing credential, and must never be
+ * turned into account rotation, model fallback, a provider retry, or a reset
+ * redemption by the auth-retry machinery.
+ */
+export const SUBSCRIPTION_USAGE_POLICY_CLASSIFICATION = "subscription_usage_policy";
+
+export type SubscriptionUsagePolicyReason =
+	| "invalid-config"
+	| "unsupported"
+	| "unknown"
+	| "hard-cap"
+	| "capacity"
+	| "cooldown";
+
+export interface SubscriptionUsagePolicyErrorOptions {
+	/** Window keys (`5h`, `7d`) whose cap/cooldown blocked the request. */
+	blockingWindows?: readonly string[];
+	/** Next moment a fresh observation or reset may make the request admissible. */
+	nextObservationAt?: number;
+	/** Safe human-readable detail (config path/field or a short explanation). */
+	detail?: string;
+}
+
+const REASON_TEXT: Record<SubscriptionUsagePolicyReason, string> = {
+	"invalid-config": "invalid configuration",
+	unsupported: "no usage attribution for this route",
+	unknown: "no trustworthy quota observation",
+	"hard-cap": "hard cap reached",
+	capacity: "background capacity exhausted",
+	cooldown: "provider cooldown",
+};
+
+/** A background request refused by the profile's subscription-usage policy. */
+export class SubscriptionUsagePolicyError extends Error {
+	readonly classification = SUBSCRIPTION_USAGE_POLICY_CLASSIFICATION;
+	readonly provider: string;
+	readonly reason: SubscriptionUsagePolicyReason;
+	readonly blockingWindows?: readonly string[];
+	readonly nextObservationAt?: number;
+	readonly detail?: string;
+
+	constructor(
+		provider: string,
+		reason: SubscriptionUsagePolicyReason,
+		options: SubscriptionUsagePolicyErrorOptions = {},
+	) {
+		const suffix = options.detail ? `; ${options.detail}` : "";
+		super(`Subscription usage policy: ${provider}: ${REASON_TEXT[reason]} (see /subscription-usage)${suffix}`);
+		this.name = "SubscriptionUsagePolicyError";
+		this.provider = provider;
+		this.reason = reason;
+		this.blockingWindows = options.blockingWindows;
+		this.nextObservationAt = options.nextObservationAt;
+		this.detail = options.detail;
+	}
+}
+
+/** True for {@link SubscriptionUsagePolicyError} values, including cross-realm/RPC copies by name. */
+export function isSubscriptionUsagePolicyError(error: unknown): error is SubscriptionUsagePolicyError {
+	if (error instanceof SubscriptionUsagePolicyError) return true;
+	return (
+		typeof error === "object" &&
+		error !== null &&
+		Reflect.get(error, "name") === "SubscriptionUsagePolicyError" &&
+		Reflect.get(error, "classification") === SUBSCRIPTION_USAGE_POLICY_CLASSIFICATION
+	);
+}
