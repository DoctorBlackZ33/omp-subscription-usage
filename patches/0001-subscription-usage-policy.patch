+			now: () => NOW,
+		});
+		await expect(controller.admit({ provider: "test-provider" })).rejects.toMatchObject({
+			name: "SubscriptionUsagePolicyError",
+			reason: "hard-cap",
+		});
+	});
+
+	it("throws cooldown for a blocked candidate", async () => {
+		const controller = new SubscriptionUsageController({
+			agentDir: "/agent",
+			policy: readyPolicy(),
+			source: sourceFor([candidate({ blockedUntil: NOW + 1_000 })]),
+			now: () => NOW,
+		});
+		await expect(controller.admit({ provider: "test-provider" })).rejects.toMatchObject({
+			name: "SubscriptionUsagePolicyError",
+			reason: "cooldown",
+		});
+	});
+
+	it("does not admit a stale usage report", async () => {
+		const controller = new SubscriptionUsageController({
+			agentDir: "/agent",
+			policy: readyPolicy(),
+			source: sourceFor([candidate({ fetchedAt: NOW - 375_001 })]),
+			now: () => NOW,
