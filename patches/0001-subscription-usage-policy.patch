diff --git a/packages/ai/test/provider-attempt-admission.test.ts b/packages/ai/test/provider-attempt-admission.test.ts
new file mode 100644
index 0000000..6c7741c
--- /dev/null
+++ b/packages/ai/test/provider-attempt-admission.test.ts
@@ -0,0 +1,161 @@
+import { afterEach, describe, expect, it } from "bun:test";
+import {
+	type ApiKeyResolution,
+	type ApiKeyResolveContext,
+	registerCustomApi,
+	SubscriptionUsagePolicyError,
+	streamSimple,
+	unregisterCustomApis,
+} from "@oh-my-pi/pi-ai";
+import type { Api, AssistantMessage, Context, Model, SimpleStreamOptions, Usage } from "@oh-my-pi/pi-ai/types";
+import { AssistantMessageEventStream } from "@oh-my-pi/pi-ai/utils/event-stream";
+
+const SOURCE_ID = "provider-attempt-admission-test";
+const API = "provider-attempt-admission-test" as Api;
+
+function usage(): Usage {
+	return {
+		input: 0,
+		output: 0,
+		cacheRead: 0,
+		cacheWrite: 0,
+		totalTokens: 0,
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+	};
+}
+
+function assistant(text = "ok"): AssistantMessage {
+	return {
+		role: "assistant",
+		content: [{ type: "text", text }],
+		api: API,
+		provider: "test-provider",
+		model: "test-model",
+		timestamp: 1,
+		stopReason: "stop",
+		usage: usage(),
+	};
+}
+
+function model(): Model<Api> {
+	return {
+		id: "test-model",
+		name: "Test Model",
+		api: API,
+		provider: "test-provider",
+		contextWindow: 1000,
+		maxTokens: 100,
+	} as Model<Api>;
+}
+
+const context: Context = {
+	systemPrompt: [],
+	messages: [{ role: "user", content: "hello", timestamp: 1 }],
+};
+
+function complete(stream: AssistantMessageEventStream): void {
+	const message = assistant();
+	stream.push({ type: "start", partial: message });
+	stream.push({ type: "done", reason: "stop", message });
+}
+
+describe("provider attempt admission", () => {
+	afterEach(() => unregisterCustomApis(SOURCE_ID));
+
+	it("reserves before dispatch and releases before delivering the terminal result", async () => {
+		const events: string[] = [];
+		registerCustomApi(
+			API,
+			(_model: Model<Api>, _context: Context, options?: SimpleStreamOptions) => {
+				events.push(`dispatch:${options?.apiKey}`);
+				const stream = new AssistantMessageEventStream();
+				queueMicrotask(() => complete(stream));
+				return stream;
+			},
+			SOURCE_ID,
+		);
+		const admission = {
+			reserve: async (credentialId: number | undefined) => {
+				events.push(`reserve:${credentialId}`);
+				return async () => {
+					events.push("release");
+				};
+			},
+		};
+		const stream = streamSimple(model(), context, {
+			apiKey: (): ApiKeyResolution => ({ apiKey: "key-1", credentialId: 42, providerAttemptAdmission: admission }),
+		});
+		const result = await stream.result();
+		expect(result.stopReason).toBe("stop");
+		expect(events).toEqual(["reserve:42", "dispatch:key-1", "release"]);
+	});
+
+	it("keeps a local policy denial typed and terminal", async () => {
+		let dispatched = false;
+		registerCustomApi(
+			API,
+			() => {
+				dispatched = true;
+				const stream = new AssistantMessageEventStream();
+				queueMicrotask(() => complete(stream));
+				return stream;
+			},
+			SOURCE_ID,
+		);
+		const denial = new SubscriptionUsagePolicyError("test-provider", "hard-cap");
+		const stream = streamSimple(model(), context, {
+			apiKey: () => {
+				throw denial;
+			},
+		});
+		let failed: unknown;
+		try {
+			await stream.result();
+		} catch (error) {
+			failed = error;
+		}
+		expect(failed).toBeInstanceOf(SubscriptionUsagePolicyError);
+		expect((failed as SubscriptionUsagePolicyError).reason).toBe("hard-cap");
+		expect((failed as Error).message).toContain("Subscription usage policy: test-provider: hard cap reached");
+		expect(dispatched).toBe(false);
+	});
+
+	it("releases each attempt's lease before the next credential is resolved", async () => {
+		const events: string[] = [];
+		let attempts = 0;
+		registerCustomApi(
+			API,
+			(_model: Model<Api>, _context: Context, options?: SimpleStreamOptions) => {
+				attempts++;
+				events.push(`dispatch:${options?.apiKey}`);
+				const stream = new AssistantMessageEventStream();
+				if (attempts === 1) {
+					queueMicrotask(() => stream.fail(Object.assign(new Error("401 denied"), { status: 401 })));
+				} else {
+					queueMicrotask(() => complete(stream));
+				}
+				return stream;
+			},
+			SOURCE_ID,
+		);
+		const resolver = (ctx: ApiKeyResolveContext): ApiKeyResolution => {
+			const credentialId = ctx.error === undefined ? 1 : 2;
+			return {
+				apiKey: `key-${credentialId}`,
+				credentialId,
+				providerAttemptAdmission: {
+					reserve: async (id: number | undefined) => {
+						events.push(`reserve:${id}`);
+						return async () => {
+							events.push(`release:${id}`);
+						};
+					},
+				},
+			};
+		};
+		const stream = streamSimple(model(), context, { apiKey: resolver });
+		const result = await stream.result();
+		expect(result.stopReason).toBe("stop");
+		expect(events).toEqual(["reserve:1", "dispatch:key-1", "release:1", "reserve:2", "dispatch:key-2", "release:2"]);
+	});
+});
diff --git a/packages/ai/test/subscription-usage-auth.test.ts b/packages/ai/test/subscription-usage-auth.test.ts
new file mode 100644
index 0000000..9facbf4
