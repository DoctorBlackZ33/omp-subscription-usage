+			sleep: signalAwareSleep(sleepers),
+		});
+		const first = await controller.admit({ provider: "test-provider" });
+		const second = await controller.admit({ provider: "test-provider" });
+		if (first.status !== "admitted" || second.status !== "admitted")
+			throw new Error("initial slots were not admitted");
+
+		snapshot.meters[0]!.usedFraction = 0.45;
+		let thirdSettled = false;
+		const thirdPromise = controller.admit({ provider: "test-provider" }).then(result => {
+			thirdSettled = true;
+			return result;
+		});
+		await waitUntil(() => sleepers.count > 0);
+		await controller.release(first.leaseId);
+		await waitUntil(() => sleepers.count > 1);
+		expect(thirdSettled).toBe(false);
+		await controller.release(second.leaseId);
+		expect((await thirdPromise).status).toBe("admitted");
+	});
+
+	it("uses an account override when computing headroom", async () => {
+		const policy = readyPolicy({
+			maxInFlight: 4,
+			fiveHourHard: 50,
