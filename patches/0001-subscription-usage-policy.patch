@@ -0,0 +1,180 @@
+import { describe, expect, test } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import {
+	curveFor,
+	evaluateCurve,
+	loadSubscriptionUsagePolicy,
+	SUBSCRIPTION_USAGE_FILENAME,
+	type PolicyLoad,
+	type WindowCurve,
+} from "../src/task/subscription-usage";
+
+const EXAMPLE_POLICY = `version: 1
+providers:
+  openai-codex:
+    maxInFlight: 4
+    maxWait: 5m
+    windows:
+      5h:
+        mode: linear
+        points:
+          - ["5h", 10, 5]
+          - ["0m", 100, 95]
+      7d:
+        mode: linear
+        points:
+          - ["7d", 20]
+          - ["1d", 90]
+          - ["0h", 97]
+    accounts:
+      "credential:42":
+        windows:
+          5h:
+            mode: step
+            points:
+              - ["5h", 0]
+              - ["0m", 100]
+`;
+
+const VALID_WINDOWS = `    windows:
+      5h:
+        mode: linear
+        points: [["5h", 10], ["0m", 100]]
+      7d:
+        mode: linear
+        points: [["7d", 20], ["1d", 90], ["0h", 97]]`;
+
+async function withTempDir<T>(run: (dir: string) => Promise<T>): Promise<T> {
+	const dir = await fs.mkdtemp(path.join(os.tmpdir(), "omp-subscription-usage-"));
+	try {
+		return await run(dir);
+	} finally {
+		await fs.rm(dir, { recursive: true, force: true });
+	}
+}
+
+async function loadYaml(yaml: string): Promise<PolicyLoad> {
+	return withTempDir(async dir => {
+		await fs.writeFile(path.join(dir, SUBSCRIPTION_USAGE_FILENAME), yaml);
+		return loadSubscriptionUsagePolicy(dir);
+	});
+}
+
+function expectFieldError(result: PolicyLoad, field: string): void {
+	expect(result.status).toBe("error");
+	if (result.status === "error") {
+		expect(result.message).toContain(result.path);
+		expect(result.message).toContain(field);
+	}
+}
+
+function weeklyCurve(mode: WindowCurve["mode"]): WindowCurve {
+	return {
+		mode,
+		points: [
+			{ remainingMinutes: 7 * 24 * 60, hardPercent: 20, softPercent: 10 },
+			{ remainingMinutes: 24 * 60, hardPercent: 90, softPercent: 80 },
+			{ remainingMinutes: 0, hardPercent: 97, softPercent: 95 },
+		],
+	};
+}
+
+describe("subscription usage policy", () => {
+	test("loads the example policy and applies account window overrides without merging", async () => {
+		const result = await loadYaml(EXAMPLE_POLICY);
+		expect(result.status).toBe("ready");
+		if (result.status !== "ready") return;
+
+		const provider = result.policy.providers["openai-codex"];
+		expect(provider.maxInFlight).toBe(4);
+		expect(provider.maxWaitMs).toBe(5 * 60_000);
+		const overridden = curveFor(provider, "fiveHour", 42);
+		expect(overridden).toBe(provider.accounts["credential:42"]!.windows.fiveHour!);
+		expect(overridden.mode).toBe("step");
+		expect(overridden.points).toHaveLength(2);
+		expect(curveFor(provider, "weekly", 42)).toBe(provider.weekly);
+		expect(curveFor(provider, "fiveHour", 43)).toBe(provider.fiveHour);
+	});
+
+	test("evaluates linear weekly points at endpoints, knots, and the midpoint", async () => {
+		const result = await loadYaml(EXAMPLE_POLICY);
+		expect(result.status).toBe("ready");
+		if (result.status !== "ready") return;
+		const curve = result.policy.providers["openai-codex"].weekly;
+
+		expect(evaluateCurve(curve, 7 * 24 * 60)).toEqual({ hardPercent: 20 });
+		expect(evaluateCurve(curve, 4 * 24 * 60)).toEqual({ hardPercent: 55 });
+		expect(evaluateCurve(curve, 24 * 60)).toEqual({ hardPercent: 90 });
+	});
+
+	test("step holds the earlier point until an exact knot", () => {
+		const curve = weeklyCurve("step");
+		expect(evaluateCurve(curve, 4 * 24 * 60)).toEqual({ hardPercent: 20, softPercent: 10 });
+		expect(evaluateCurve(curve, 24 * 60)).toEqual({ hardPercent: 90, softPercent: 80 });
+	});
+
+	test("smooth interpolation and soft values share the curve shape and clamp at endpoints", () => {
+		const curve = weeklyCurve("smooth");
+		expect(evaluateCurve(curve, 5.5 * 24 * 60)).toEqual({ hardPercent: 30.9375, softPercent: 20.9375 });
+		expect(evaluateCurve(curve, 8 * 24 * 60)).toEqual({ hardPercent: 20, softPercent: 10 });
+		expect(evaluateCurve(curve, -1)).toEqual({ hardPercent: 97, softPercent: 95 });
+		expect(evaluateCurve(curve, Number.NaN)).toBeUndefined();
+	});
+
+	test("rejects malformed curve points with their field path", async () => {
+		const yaml = `version: 1\nproviders:\n  test:\n    maxInFlight: 2\n${VALID_WINDOWS.replace('["1d", 90]', '["1d", "bad"]')}`;
+		expectFieldError(await loadYaml(yaml), "providers.test.windows.7d.points[1][1]");
+	});
+
+	test("rejects duplicate curve durations", async () => {
+		const yaml = `version: 1\nproviders:\n  test:\n    maxInFlight: 2\n${VALID_WINDOWS.replace('["1d", 90]', '["7d", 90]')}`;
+		expectFieldError(await loadYaml(yaml), "providers.test.windows.7d.points[1][0]");
+	});
+
+	test("rejects invalid maxInFlight, missing windows, and descending soft caps", async () => {
+		const badMax = `version: 1\nproviders:\n  test:\n    maxInFlight: 0\n${VALID_WINDOWS}`;
+		expectFieldError(await loadYaml(badMax), "providers.test.maxInFlight");
+
+		const missingWeekly = `version: 1\nproviders:\n  test:\n    maxInFlight: 2\n    windows:\n      5h:\n        mode: linear\n        points: [["5h", 10], ["0m", 100]]\n`;
+		expectFieldError(await loadYaml(missingWeekly), "providers.test.windows.7d");
+
+		const badSoft = `version: 1\nproviders:\n  test:\n    maxInFlight: 2\n    windows:\n      5h:\n        mode: linear\n        points: [["5h", 10, 5], ["0m", 100, 4]]\n      7d:\n        mode: linear\n        points: [["7d", 20], ["0h", 97]]\n`;
+		expectFieldError(await loadYaml(badSoft), "providers.test.windows.5h.points[1][2]");
+	});
+
+	test("uses the five-minute default when maxWait is omitted", async () => {
+		const yaml = `version: 1\nproviders:\n  test:\n    maxInFlight: 2\n${VALID_WINDOWS}`;
+		const result = await loadYaml(yaml);
+		expect(result.status).toBe("ready");
+		if (result.status === "ready") expect(result.policy.providers.test.maxWaitMs).toBe(5 * 60_000);
+	});
+
+	test("treats an absent agent config as disabled", async () => {
+		await withTempDir(async dir => {
+			expect(loadSubscriptionUsagePolicy(dir)).toEqual({
+				status: "disabled",
+				path: path.join(dir, SUBSCRIPTION_USAGE_FILENAME),
+			});
+		});
+	});
+
+	test("ignores a project-directory policy and reads only the agent directory", async () => {
+		await withTempDir(async root => {
+			const agentDir = path.join(root, "agent");
+			await fs.mkdir(agentDir);
+			await fs.writeFile(path.join(root, SUBSCRIPTION_USAGE_FILENAME), EXAMPLE_POLICY);
+			const originalCwd = process.cwd();
+			try {
+				process.chdir(root);
+				expect(loadSubscriptionUsagePolicy(agentDir)).toEqual({
+					status: "disabled",
+					path: path.join(agentDir, SUBSCRIPTION_USAGE_FILENAME),
+				});
+			} finally {
+				process.chdir(originalCwd);
+			}
+		});
+	});
+});
