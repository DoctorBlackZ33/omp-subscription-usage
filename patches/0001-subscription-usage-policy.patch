+import { describe, expect, it } from "bun:test";
+import { SubscriptionUsagePolicyError } from "@oh-my-pi/pi-ai";
+import type { PolicyLoad, SubscriptionUsagePolicy, WindowCurve } from "../src/task/subscription-usage";
+import {
+	SubscriptionUsageController,
+	type SubscriptionCandidateSnapshot,
+	type SubscriptionCandidatesSource,
+} from "../src/task/subscription-usage-controller";
+
+const NOW = 1_000_000;
+const CONFIG_PATH = "/agent/subscription-usage.yml";
+const FIVE_HOUR_MS = 300 * 60_000;
+const WEEKLY_MS = 10080 * 60_000;
+
+function curve(hardPercent: number, softPercent?: number): WindowCurve {
+	const point = (remainingMinutes: number) => ({
+		remainingMinutes,
+		hardPercent,
+		...(softPercent === undefined ? {} : { softPercent }),
+	});
+	return { mode: "linear", points: [point(300), point(0)] };
+}
+
+function readyPolicy(
+	options: {
+		maxInFlight?: number;
+		maxWaitMs?: number;
+		fiveHourHard?: number;
+		fiveHourSoft?: number;
+		weeklyHard?: number;
+		weeklySoft?: number;
+		accounts?: SubscriptionUsagePolicy["providers"][string]["accounts"];
+	} = {},
+): PolicyLoad {
+	return {
+		status: "ready",
+		path: CONFIG_PATH,
+		policy: {
+			version: 1,
+			providers: {
+				"test-provider": {
+					maxInFlight: options.maxInFlight ?? 4,
+					maxWaitMs: options.maxWaitMs ?? 0,
+					fiveHour: curve(options.fiveHourHard ?? 65, options.fiveHourSoft ?? 50),
+					weekly: curve(options.weeklyHard ?? 100, options.weeklySoft ?? 90),
+					accounts: options.accounts ?? {},
+				},
+			},
+		},
+	};
+}
+
+function candidate(
+	options: {
+		credentialId?: number;
+		poolId?: string;
+		order?: number;
+		fetchedAt?: number | null;
+		blockedUntil?: number;
+		fiveHourUsed?: number;
+		weeklyUsed?: number;
+		fiveHourReset?: number;
+		weeklyReset?: number;
+		identity?: string;
+	} = {},
+): SubscriptionCandidateSnapshot {
+	return {
+		credentialId: options.credentialId ?? 1,
+		poolId: options.poolId ?? "pool-a",
+		order: options.order ?? 0,
+		fetchedAt: options.fetchedAt === undefined ? NOW : options.fetchedAt,
+		...(options.blockedUntil === undefined ? {} : { blockedUntil: options.blockedUntil }),
+		...(options.identity === undefined ? {} : { identity: options.identity }),
+		meters: [
+			{
+				id: "5h-meter",
+				label: "5-hour",
+				durationMs: FIVE_HOUR_MS,
+				resetsAt: options.fiveHourReset ?? NOW + FIVE_HOUR_MS,
+				usedFraction: options.fiveHourUsed ?? 0.3,
+			},
+			{
+				id: "7d-meter",
+				label: "weekly",
+				durationMs: WEEKLY_MS,
+				resetsAt: options.weeklyReset ?? NOW + WEEKLY_MS,
+				usedFraction: options.weeklyUsed ?? 0,
+			},
+		],
+	};
+}
+
+function sourceFor(candidates: readonly SubscriptionCandidateSnapshot[]): SubscriptionCandidatesSource {
+	return { candidates: async () => ({ supported: true, candidates }) };
+}
+
+function signalAwareSleep(counter?: { count: number }): (ms: number, signal?: AbortSignal) => Promise<void> {
+	return (_ms, signal) => {
+		if (counter) counter.count++;
+		if (signal?.aborted) return Promise.resolve();
+		const { promise, resolve } = Promise.withResolvers<void>();
+		signal?.addEventListener("abort", () => resolve(), { once: true });
+		return promise;
+	};
+}
+
+async function waitUntil(predicate: () => boolean): Promise<void> {
+	for (let attempt = 0; attempt < 100; attempt++) {
+		if (predicate()) return;
+		await Promise.resolve();
+	}
+	throw new Error("condition was not reached");
+}
+
+describe("SubscriptionUsageController", () => {
