+			policy: readyPolicy({ maxInFlight: 4, maxWaitMs: 60_000 }),
+			source: sourceFor([candidate({ fiveHourUsed: 0.3 })]),
+			now: () => NOW,
+			sleep: signalAwareSleep(sleepers),
+		});
+
+		const first = await controller.admit({ provider: "test-provider" });
+		const second = await controller.admit({ provider: "test-provider" });
+		expect(first.status).toBe("admitted");
+		expect(second.status).toBe("admitted");
+		if (first.status !== "admitted") throw new Error("first request was not admitted");
+
+		let thirdSettled = false;
+		const thirdPromise = controller.admit({ provider: "test-provider" }).then(result => {
+			thirdSettled = true;
+			return result;
+		});
+		await waitUntil(() => sleepers.count > 0);
+		expect(thirdSettled).toBe(false);
+		await controller.release(first.leaseId);
+		const third = await thirdPromise;
+		expect(third.status).toBe("admitted");
+	});
+
+	it("does not dispatch after headroom falls to 20 with one running, then admits after the second release", async () => {
+		const sleepers = { count: 0 };
