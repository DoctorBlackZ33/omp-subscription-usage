new file mode 100644
index 0000000..c92376f
--- /dev/null
+++ b/packages/coding-agent/src/thread/services/subscription-usage.ts
@@ -0,0 +1,141 @@
+/**
+ * Subscription-usage admission bridge between the main thread and subagent
+ * workers.
+ *
+ * The controller — and therefore the background slot counters — lives on the
+ * main thread for the whole profile. A worker receives one endpoint per peer;
+ * `admit` may wait there under the worker's own abort signal, and every lease
+ * the worker holds is released when the worker exits. Policy configuration and
+ * usage probes never move into the worker.
+ */
+import { getAgentDir } from "@oh-my-pi/pi-utils";
+import type { WorkerThreadLink } from "../protocol";
+import { type RemoteObject, type RpcMethod } from "../rpc";
+import type { ThreadService, WorkerPeer } from "../services";
+import type { SubscriptionCandidateRequest } from "../../task/subscription-usage-controller";
+import {
+	getMainSubscriptionUsageController,
+	setRemoteSubscriptionUsageController,
+	type SubscriptionAdmitResult,
+	type SubscriptionUsageControllerLike,
+} from "../../task/subscription-usage-wiring";
+
+/** Exported-class kind of one worker's main-side subscription-usage endpoint. */
+export const SUBSCRIPTION_USAGE_KIND = "subscription-usage";
+
+/** Methods a worker calls on its main-side endpoint. */
+export type SubscriptionUsageProtocol = {
+	admit: RpcMethod<[request: SubscriptionCandidateRequest], SubscriptionAdmitResult>;
+	release: RpcMethod<[leaseId: number], void>;
+	status: RpcMethod<[], string>;
+};
+
+/** Boot globals of {@link subscriptionUsageThreadService}. */
+export interface SubscriptionUsageServiceGlobals {
+	readonly endpoint: PeerSubscriptionUsageEndpoint;
+}
+
+/** Main-side endpoint of one worker; tracks its leases and pending waits. */
+export class PeerSubscriptionUsageEndpoint {
+	readonly #exit = new AbortController();
+	readonly #leases = new Set<number>();
+
+	#controller(): SubscriptionUsageControllerLike {
+		const agentDir = getAgentDir();
+		return getMainSubscriptionUsageController(agentDir);
+	}
+
+	async admit(request: SubscriptionCandidateRequest): Promise<SubscriptionAdmitResult> {
+		const signal = request.signal ? AbortSignal.any([request.signal, this.#exit.signal]) : this.#exit.signal;
+		const controller = this.#controller();
+		const result = await controller.admit({ ...request, signal });
+		if (result.status === "admitted") this.#leases.add(result.leaseId);
+		return result;
+	}
+
+	async release(leaseId: number): Promise<void> {
+		this.#leases.delete(leaseId);
+		await this.#controller().release(leaseId);
+	}
+
+	status(): Promise<string> {
+		return this.#controller().status();
+	}
+
+	/** Worker exit: stop waits and free every slot it still held. */
+	close(): void {
+		this.#exit.abort(new Error("Subagent worker exited"));
+		if (this.#leases.size === 0) return;
+		const controller = this.#controller();
+		for (const leaseId of this.#leases) void controller.release(leaseId);
+		this.#leases.clear();
+	}
+}
+
+/** Worker-side proxy of {@link PeerSubscriptionUsageEndpoint}. */
+export class RemoteSubscriptionUsageController implements SubscriptionUsageControllerLike {
+	readonly #remote: RemoteObject<SubscriptionUsageProtocol>;
+
+	constructor(remote: RemoteObject<SubscriptionUsageProtocol>) {
+		this.#remote = remote;
+	}
+
+	admit(request: SubscriptionCandidateRequest): Promise<SubscriptionAdmitResult> {
+		return this.#remote.call("admit", request);
+	}
+
+	release(leaseId: number): Promise<void> {
+		return this.#remote.call("release", leaseId);
+	}
+
+	status(): Promise<string> {
+		return this.#remote.call("status");
+	}
+}
+
+const endpoints = new WeakMap<WorkerPeer, PeerSubscriptionUsageEndpoint>();
+
+/** Per-profile background admission slots shared by main and every worker. */
+export const subscriptionUsageThreadService: ThreadService = {
+	name: "subscriptionUsage",
+
+	installMain(peer: WorkerPeer): void {
+		const endpoint = new PeerSubscriptionUsageEndpoint();
+		endpoints.set(peer, endpoint);
+		peer.link.exportClass<PeerSubscriptionUsageEndpoint, SubscriptionUsageProtocol>(
+			SUBSCRIPTION_USAGE_KIND,
+			(value): value is PeerSubscriptionUsageEndpoint => value instanceof PeerSubscriptionUsageEndpoint,
+			{
+				admit: (target, request) => target.admit(request),
+				release: (target, leaseId) => target.release(leaseId),
+				status: target => target.status(),
+			},
+		);
+	},
+
+	globals(peer: WorkerPeer): SubscriptionUsageServiceGlobals {
+		const endpoint = endpoints.get(peer);
+		if (!endpoint) throw new Error("subscription-usage service: endpoint missing for worker");
+		return { endpoint };
+	},
+
+	onWorkerExit(peer: WorkerPeer): void {
+		endpoints.get(peer)?.close();
+		endpoints.delete(peer);
+	},
+
+	installWorker(link: WorkerThreadLink): void {
+		link.importClass<RemoteSubscriptionUsageController, SubscriptionUsageProtocol>(
+			SUBSCRIPTION_USAGE_KIND,
+			remote => new RemoteSubscriptionUsageController(remote),
+		);
+	},
+
+	async boot(globals: unknown): Promise<void> {
+		const endpoint = (globals as Partial<SubscriptionUsageServiceGlobals> | undefined)?.endpoint;
+		if (!(endpoint instanceof RemoteSubscriptionUsageController)) {
+			throw new Error("subscription-usage service: boot globals lack the main endpoint");
+		}
+		setRemoteSubscriptionUsageController(endpoint);
+	},
+};
