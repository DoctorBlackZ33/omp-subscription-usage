+			]),
+			now: () => NOW,
+		});
+		expect(await controller.admit({ provider: "test-provider" })).toMatchObject({
+			status: "admitted",
+			credentialId: 2,
+		});
+	});
+
+	it("uses a soft fallback only after the preferred pool is full", async () => {
+		const controller = new SubscriptionUsageController({
+			agentDir: "/agent",
+			policy: readyPolicy({ maxInFlight: 4, fiveHourHard: 75, fiveHourSoft: 60 }),
+			source: sourceFor([
+				candidate({ credentialId: 1, poolId: "preferred", fiveHourUsed: 0.5 }),
+				candidate({ credentialId: 2, poolId: "fallback", order: 1, fiveHourUsed: 0.65 }),
+			]),
+			now: () => NOW,
+		});
+		expect(await controller.admit({ provider: "test-provider" })).toMatchObject({
+			status: "admitted",
+			credentialId: 1,
+		});
+		expect(await controller.admit({ provider: "test-provider" })).toMatchObject({
+			status: "admitted",
+			credentialId: 2,
+		});
+	});
+
+	it("throws a hard-cap error at zero headroom", async () => {
+		const controller = new SubscriptionUsageController({
+			agentDir: "/agent",
+			policy: readyPolicy({ fiveHourHard: 65 }),
