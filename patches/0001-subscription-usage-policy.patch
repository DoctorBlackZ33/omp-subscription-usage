+/**
+ * Opt-in subscription-usage admission for subagent inference.
+ *
+ * The profile's `subscription-usage.yml` shapes two quota windows into hard and
+ * soft caps and caps background concurrency. This module is the coding-agent
+ * seam: it resolves the profile controller (local on main, bridged in a worker
+ * thread), pins the admitted durable credential for the native auth resolver,
+ * and carries the lease into the streaming attempt so it is released exactly
+ * once at that attempt's terminal boundary.
+ *
+ * Interactive chat never reaches this wrapper; only sessions with
+ * `taskDepth > 0` / `parentTaskPrefix` wrap their resolver.
+ */
+import type { AgentOptions } from "@oh-my-pi/pi-agent-core";
+import {
+	type ApiKey,
+	type ApiKeyResolver,
+	type AuthStorage,
+	isApiKeyResolver,
+	type ResolvedApiKey,
+	SubscriptionUsagePolicyError,
+} from "@oh-my-pi/pi-ai";
+import { getAgentDir } from "@oh-my-pi/pi-utils";
+import { isMainThread } from "../thread/identity";
+import { loadSubscriptionUsagePolicy } from "./subscription-usage";
+import {
+	SubscriptionUsageController,
+	type SubscriptionCandidateRequest,
+	type SubscriptionCandidateSnapshot,
+	type SubscriptionCandidatesSource,
+} from "./subscription-usage-controller";
+
+/** Outcome of one admission decision, shared with the worker bridge. */
+export type SubscriptionAdmitResult =
+	| { status: "admitted"; credentialId: number; leaseId: number }
+	| { status: "unconfigured" };
+
+/** Controller surface shared by the main-thread instance and the worker proxy. */
+export interface SubscriptionUsageControllerLike {
+	admit(request: SubscriptionCandidateRequest): Promise<SubscriptionAdmitResult>;
+	release(leaseId: number): Promise<void>;
+	status(): Promise<string>;
+}
+
+const controllers = new Map<string, SubscriptionUsageControllerLike>();
+const storages = new Map<string, AuthStorage>();
+let remoteController: SubscriptionUsageControllerLike | undefined;
+
+/** Worker thread: install the controller proxy booted by the thread service. */
+export function setRemoteSubscriptionUsageController(controller: SubscriptionUsageControllerLike | undefined): void {
+	remoteController = controller;
+}
+
+/** Remember the profile's auth storage so a worker bridge can evaluate the same pool. */
+export function registerSubscriptionUsageAuthStorage(agentDir: string, storage: AuthStorage): void {
+	storages.set(agentDir, storage);
+	// Read the policy once at profile startup (first session construction) rather
+	// than on the first background request. A malformed file is retained as an
+	// explicit configuration error; interactive sessions still start.
+	if (isMainThread() && !controllers.has(agentDir)) getMainSubscriptionUsageController(agentDir, storage);
+}
+
+/** Auth-storage-backed candidate source (main thread only). */
+class AuthStorageSubscriptionSource implements SubscriptionCandidatesSource {
+	readonly #storage: AuthStorage;
+
+	constructor(storage: AuthStorage) {
+		this.#storage = storage;
+	}
+
+	async candidates(
+		request: SubscriptionCandidateRequest,
+	): Promise<{ supported: boolean; candidates: readonly SubscriptionCandidateSnapshot[] }> {
+		const result = await this.#storage.keys.subscriptionCandidates(request.provider, request.sessionId, {
+			baseUrl: request.baseUrl,
+			modelId: request.modelId,
+			serviceTier: request.serviceTier,
+			accountIds: request.accountIds,
+			signal: request.signal,
+		});
+		return { supported: result.supported, candidates: result.candidates };
+	}
+}
+
+/** Main thread: one controller per profile root, policy read once. */
+export function getMainSubscriptionUsageController(
+	agentDir: string,
+	storage?: AuthStorage,
+): SubscriptionUsageControllerLike {
+	let controller = controllers.get(agentDir);
+	if (controller) return controller;
+	const known = storage ?? storages.get(agentDir);
+	if (!known) throw new Error(`Subscription usage policy: no auth storage registered for ${agentDir}`);
+	storages.set(agentDir, known);
+	controller = new SubscriptionUsageController({
+		agentDir,
+		policy: loadSubscriptionUsagePolicy(agentDir),
+		source: new AuthStorageSubscriptionSource(known),
+	});
+	controllers.set(agentDir, controller);
+	return controller;
+}
+
+/** The controller this session's resolver must use. */
+export function getSessionSubscriptionUsageController(
+	agentDir: string,
+	storage?: AuthStorage,
+): SubscriptionUsageControllerLike {
+	if (!isMainThread()) {
+		if (!remoteController) throw new Error("Subscription usage policy: worker controller bridge is not booted");
+		return remoteController;
+	}
+	return getMainSubscriptionUsageController(agentDir, storage);
+}
+
+/** Test seam: install a fake controller for one profile root. */
+export function setSubscriptionUsageControllerForTesting(
+	agentDir: string,
+	controller: SubscriptionUsageControllerLike | undefined,
+): void {
+	if (controller) controllers.set(agentDir, controller);
+	else controllers.delete(agentDir);
+}
+
+/** Test seam: drop cached controllers/policies/storage registrations. */
+export function resetSubscriptionUsageControllersForTesting(): void {
+	controllers.clear();
+	storages.clear();
+	remoteController = undefined;
+}
+
+function wrapResolver(
+	resolver: ApiKeyResolver,
+	model: Parameters<NonNullable<AgentOptions["getApiKey"]>>[0],
+	agentDir: string,
+	sessionId: string | undefined,
+	storage: AuthStorage | undefined,
+): ApiKeyResolver {
+	const provider = model.provider;
+	return async ctx => {
+		// Provider-driven refresh/rotation after a genuine failure uses the
+		// native recovery path unchanged. The failed attempt already released
+		// its lease; this retry must not be pinned to the now-failed row.
+		if (ctx.error !== undefined) return resolver(ctx);
+		const controller = getSessionSubscriptionUsageController(agentDir, storage);
+		const admitted = await controller.admit({
+			provider,
+			modelId: model.id,
+			baseUrl: model.baseUrl,
+			serviceTier: ctx.serviceTier,
+			sessionId,
+			...(model.accountAccess ? { accountIds: Object.keys(model.accountAccess) } : {}),
+			signal: ctx.signal,
+		});
+		if (admitted.status === "unconfigured") return resolver(ctx);
+		const leaseId = admitted.leaseId;
+		let released = false;
+		const onAbort = () => {
+			void release();
+		};
+		const release = async (): Promise<void> => {
+			if (released) return;
+			released = true;
+			ctx.signal?.removeEventListener("abort", onAbort);
+			await controller.release(leaseId);
+		};
+		ctx.signal?.addEventListener("abort", onAbort, { once: true });
+		if (ctx.signal?.aborted) {
+			await release();
+			throw ctx.signal.reason ?? new Error("Request aborted before subscription usage dispatch");
+		}
+		try {
+			const resolution = await resolver({ ...ctx, preferredCredentialId: admitted.credentialId });
+			const object = typeof resolution === "object" && resolution !== null ? resolution : undefined;
+			if (object?.credentialId !== admitted.credentialId) {
+				// The native resolver could not honor the admitted row (it was
+				// blocked, removed, or fell through to an API key/env source).
+				// Never let a different credential ride this lease.
+				await release();
+				throw new SubscriptionUsagePolicyError(provider, "unknown", {
+					detail: `admitted credential:${admitted.credentialId} is no longer available`,
+				});
+			}
+			const resolved: ResolvedApiKey = {
+				...object,
+				providerAttemptAdmission: {
+					reserve: async credentialId => {
+						if (credentialId !== admitted.credentialId) {
+							await release();
+							throw new SubscriptionUsagePolicyError(provider, "unknown", {
+								detail: `dispatched credential does not match admitted credential:${admitted.credentialId}`,
+							});
+						}
+						return release;
+					},
+				},
+			};
+			return resolved;
+		} catch (error) {
+			await release();
+			throw error;
+		}
+	};
+}
+
+/**
+ * Wrap a session's request-key resolver with subscription-usage admission.
+ * Only resolver forms participate; static keys have no credential to admit.
+ */
+export function withSubscriptionUsagePolicy(
+	base: NonNullable<AgentOptions["getApiKey"]>,
+	options: {
+		agentDir?: string;
+		sessionId: () => string | undefined;
+		storage?: AuthStorage;
+	},
+): NonNullable<AgentOptions["getApiKey"]> {
+	const agentDir = options.agentDir ?? getAgentDir();
+	return model => {
+		const unwrap = (key: ApiKey | undefined): ApiKey | undefined => {
+			if (!isApiKeyResolver(key)) return key;
+			return wrapResolver(key, model, agentDir, options.sessionId(), options.storage);
+		};
+		const resolved = base(model);
+		return resolved instanceof Promise ? resolved.then(unwrap) : unwrap(resolved);
+	};
+}
