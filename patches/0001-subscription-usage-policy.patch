+import { afterEach, describe, expect, it } from "bun:test";
+import {
+	type ApiKey,
+	type ApiKeyResolveContext,
+	type ApiKeyResolver,
+	SubscriptionUsagePolicyError,
+} from "@oh-my-pi/pi-ai";
+import type { Model } from "@oh-my-pi/pi-ai/types";
+import {
+	resetSubscriptionUsageControllersForTesting,
+	setSubscriptionUsageControllerForTesting,
+	withSubscriptionUsagePolicy,
+} from "../src/task/subscription-usage-wiring";
+
+const AGENT_DIR = "/tmp/subscription-usage-wiring-test";
+
+function model(): Model {
+	return {
+		id: "model-1",
+		name: "Model 1",
+		api: "openai-codex-responses",
+		provider: "openai-codex",
+		contextWindow: 1000,
+		maxTokens: 100,
+	} as Model;
+}
