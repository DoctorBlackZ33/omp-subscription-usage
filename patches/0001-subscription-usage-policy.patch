+import { SubscriptionUsagePolicyError, type ServiceTier, type SubscriptionUsagePolicyReason } from "@oh-my-pi/pi-ai";
+import {
+	curveFor,
+	evaluateCurve,
+	type PolicyLoad,
+	type ProviderPolicy,
+	type SubscriptionUsagePolicy,
+} from "./subscription-usage";
+
+export interface SubscriptionMeterSnapshot {
+	id: string;
+	label: string;
+	/** 300*60_000 for the 5h window, 10080*60_000 for weekly. */
+	durationMs: number;
+	resetsAt?: number;
+	usedFraction?: number;
+	status?: string;
+}
+
+export interface SubscriptionCandidateSnapshot {
+	credentialId: number;
+	poolId: string;
+	order: number;
+	fetchedAt: number | null;
+	blockedUntil?: number;
+	meters: SubscriptionMeterSnapshot[];
+	identity?: string;
+}
+
+export interface SubscriptionCandidateRequest {
+	provider: string;
+	modelId?: string;
+	baseUrl?: string;
+	serviceTier?: ServiceTier;
+	sessionId?: string;
+	accountIds?: readonly string[];
+	signal?: AbortSignal;
+}
+
+export interface SubscriptionCandidatesSource {
+	candidates(request: SubscriptionCandidateRequest): Promise<{
+		supported: boolean;
+		candidates: readonly SubscriptionCandidateSnapshot[];
+	}>;
+}
+
+export interface SubscriptionUsageControllerOptions {
+	agentDir: string;
+	policy: PolicyLoad;
+	source: SubscriptionCandidatesSource;
+	now?: () => number;
+	sleep?: (ms: number, signal?: AbortSignal) => Promise<void>;
+	freshMs?: number;
+	pollMs?: number;
+}
+
+const FIVE_HOUR_MINUTES = 300;
+const WEEKLY_MINUTES = 10080;
+const FIVE_HOUR_MS = FIVE_HOUR_MINUTES * 60_000;
+const WEEKLY_MS = WEEKLY_MINUTES * 60_000;
+const DEFAULT_FRESH_MS = 375_000;
+const DEFAULT_POLL_MS = 15_000;
+
+type WindowKey = "fiveHour" | "weekly";
+
+interface MeterEvaluation {
+	meter: SubscriptionMeterSnapshot;
+	window?: WindowKey;
+	usedPercent?: number;
+	softPercent?: number;
+	hardPercent?: number;
+	resetsInMs?: number;
+}
+
+interface CandidateEvaluation {
+	snapshot: SubscriptionCandidateSnapshot;
+	valid: boolean;
+	blocked: boolean;
+	hasExhaustedMeter: boolean;
+	hardCapped: boolean;
+	underSoft: boolean;
+	headroom?: number;
+	remaining?: number;
+	ownCeiling: number;
+	meters: MeterEvaluation[];
+}
+
+interface CapacityEvaluation {
+	poolCapacities: Map<string, number>;
+	providerCeiling: number;
+}
+
+function defaultSleep(ms: number, signal?: AbortSignal): Promise<void> {
+	return new Promise((resolve, reject) => {
+		if (signal?.aborted) {
+			reject(signal ? abortReason(signal) : new DOMException("The operation was aborted", "AbortError"));
+			return;
+		}
+		const timer = setTimeout(
+			() => {
+				signal?.removeEventListener("abort", onAbort);
+				resolve();
+			},
+			Math.max(0, ms),
+		);
+		const onAbort = () => {
+			clearTimeout(timer);
+			signal?.removeEventListener("abort", onAbort);
+			reject(signal ? abortReason(signal) : new DOMException("The operation was aborted", "AbortError"));
+		};
+		signal?.addEventListener("abort", onAbort, { once: true });
+	});
+}
+
+function abortReason(signal: AbortSignal): unknown {
+	return signal.reason ?? new DOMException("The operation was aborted", "AbortError");
+}
+
+function throwIfAborted(signal?: AbortSignal): void {
+	if (signal?.aborted) throw abortReason(signal);
+}
+
+function clamp(value: number, min: number, max: number): number {
+	return Math.min(max, Math.max(min, value));
+}
+
+function isFiniteNumber(value: unknown): value is number {
+	return typeof value === "number" && Number.isFinite(value);
+}
+
+function windowForDuration(durationMs: number): { window: WindowKey; minutes: number } | undefined {
+	if (durationMs === FIVE_HOUR_MS) return { window: "fiveHour", minutes: FIVE_HOUR_MINUTES };
+	if (durationMs === WEEKLY_MS) return { window: "weekly", minutes: WEEKLY_MINUTES };
+	return undefined;
+}
+
+function evaluateCandidates(
+	policy: ProviderPolicy,
+	candidates: readonly SubscriptionCandidateSnapshot[],
+	now: number,
+	freshMs: number,
+): CandidateEvaluation[] {
+	return candidates.map(snapshot => {
+		const evaluation: CandidateEvaluation = {
+			snapshot,
+			valid: false,
+			blocked: snapshot.blockedUntil !== undefined && snapshot.blockedUntil > now,
+			hasExhaustedMeter: snapshot.meters.some(meter => meter.status === "exhausted"),
+			hardCapped: false,
+			underSoft: true,
+			ownCeiling: 0,
+			meters: [],
+		};
+		const fetchedAt = snapshot.fetchedAt;
+		const fresh = isFiniteNumber(fetchedAt) && now - fetchedAt >= 0 && now - fetchedAt <= freshMs;
+		let hasFiveHour = false;
+		let hasWeekly = false;
+		let complete = true;
+		let headroom = Number.POSITIVE_INFINITY;
+		let softRemaining = Number.POSITIVE_INFINITY;
+		let hasSoft = false;
+		let remaining = Number.POSITIVE_INFINITY;
+		let hardCapped = evaluation.hasExhaustedMeter;
+
+		for (const meter of snapshot.meters) {
+			const duration = windowForDuration(meter.durationMs);
+			const result: MeterEvaluation = { meter };
+			evaluation.meters.push(result);
+			if (!duration) continue;
+			result.window = duration.window;
+			const reset = meter.resetsAt;
+			if (isFiniteNumber(reset)) result.resetsInMs = reset - now;
+			const futureReset = isFiniteNumber(reset) && reset > now;
+			if (futureReset) {
+				if (duration.window === "fiveHour") hasFiveHour = true;
+				else hasWeekly = true;
+			}
+
+			const usedFraction = meter.usedFraction;
+			const usedPercent =
+				isFiniteNumber(usedFraction) && usedFraction >= 0 && Number.isFinite(usedFraction * 100)
+					? usedFraction * 100
+					: undefined;
+			if (usedPercent === undefined) {
+				if (futureReset) complete = false;
+			} else {
+				result.usedPercent = usedPercent;
+			}
+			if (!isFiniteNumber(reset)) continue;
+			const curve = curveFor(policy, duration.window, snapshot.credentialId);
+			const remainingMinutes = clamp((reset - now) / 60_000, 0, duration.minutes);
+			const values = evaluateCurve(curve, remainingMinutes);
+			if (!values) {
+				if (futureReset) complete = false;
+				continue;
+			}
+			result.hardPercent = values.hardPercent;
+			result.softPercent = values.softPercent;
+			if (!futureReset || usedPercent === undefined) continue;
+			headroom = Math.min(headroom, values.hardPercent - usedPercent);
+			remaining = Math.min(remaining, 100 - usedPercent);
+			if (values.softPercent !== undefined) {
+				softRemaining = Math.min(softRemaining, values.softPercent - usedPercent);
+				hasSoft = true;
+			}
+			if (usedPercent >= 100 || meter.status === "exhausted") hardCapped = true;
+		}
+
+		if (
+			!fresh ||
+			!hasFiveHour ||
+			!hasWeekly ||
+			!complete ||
+			!Number.isFinite(headroom) ||
+			!Number.isFinite(remaining)
+		)
+			return evaluation;
+		evaluation.valid = true;
+		evaluation.underSoft = !hasSoft || softRemaining > 0;
+		evaluation.headroom = headroom;
+		evaluation.remaining = remaining;
+		evaluation.hardCapped = hardCapped || headroom <= 0;
+		return evaluation;
+	});
+}
+
+function evaluateCapacities(policy: ProviderPolicy, candidates: CandidateEvaluation[]): CapacityEvaluation {
+	// Rows sharing one upstream quota pool contribute that pool once, and the
+	// smallest row capacity wins: the pool has one real concurrency budget, and
+	// the least-headroom observation is the conservative view of it.
+	const capacityByPool = new Map<string, number>();
+	for (const candidate of candidates) {
+		if (!candidate.valid || candidate.headroom === undefined) continue;
+		const headroom = clamp(candidate.headroom, 0, 100);
+		const capacity = Math.ceil((policy.maxInFlight * headroom) / 100);
+		candidate.ownCeiling = capacity;
+		const previous = capacityByPool.get(candidate.snapshot.poolId);
+		if (previous === undefined || capacity < previous) capacityByPool.set(candidate.snapshot.poolId, capacity);
+	}
+
+	let totalCapacity = 0;
+	for (const capacity of capacityByPool.values()) totalCapacity += capacity;
+	return {
+		poolCapacities: capacityByPool,
+		providerCeiling: Math.min(policy.maxInFlight, totalCapacity),
+	};
+}
+
+function sanitizeText(value: string): string {
+	return value.replace(/[\u0000-\u001f\u007f-\u009f]/g, "");
+}
+
+function formatPercent(value: number | undefined): string {
+	return isFiniteNumber(value) ? `${value.toFixed(1)}%` : "unknown";
+}
+
+function formatCountdown(ms: number | undefined): string {
+	if (!isFiniteNumber(ms)) return "unknown";
+	if (ms <= 0) return "expired";
+	let seconds = Math.ceil(ms / 1000);
+	const days = Math.floor(seconds / 86_400);
+	seconds -= days * 86_400;
+	const hours = Math.floor(seconds / 3_600);
+	seconds -= hours * 3_600;
+	const minutes = Math.floor(seconds / 60);
+	seconds -= minutes * 60;
+	if (days) return `${days}d ${hours}h`;
+	if (hours) return `${hours}h ${minutes}m`;
+	if (minutes) return `${minutes}m ${seconds}s`;
+	return `${seconds}s`;
+}
+
+function displayWindow(window: WindowKey | undefined, durationMs: number): string {
+	if (window === "fiveHour") return "5h";
+	if (window === "weekly") return "7d";
+	return `${Math.round(durationMs / 60_000)}m`;
+}
+
+export class SubscriptionUsageController {
+	private readonly now: () => number;
+	private readonly sleep: (ms: number, signal?: AbortSignal) => Promise<void>;
+	private readonly freshMs: number;
+	private readonly pollMs: number;
+	private readonly runningByProvider = new Map<string, number>();
+	private readonly runningByPool = new Map<string, Map<string, number>>();
+	private readonly waitingByProvider = new Map<string, number>();
+	private readonly leases = new Map<number, { provider: string; poolId: string }>();
+	private readonly waiters = new Set<() => void>();
+	private nextLeaseId = 1;
+	private wakeVersion = 0;
+
+	constructor(private readonly options: SubscriptionUsageControllerOptions) {
+		this.now = options.now ?? Date.now;
+		this.sleep = options.sleep ?? defaultSleep;
+		this.freshMs = options.freshMs ?? DEFAULT_FRESH_MS;
+		this.pollMs = options.pollMs ?? DEFAULT_POLL_MS;
+	}
+
+	async admit(
+		request: SubscriptionCandidateRequest,
+	): Promise<{ status: "admitted"; credentialId: number; leaseId: number } | { status: "unconfigured" }> {
+		const { policy } = this.options;
+		if (policy.status === "disabled") return { status: "unconfigured" };
+		if (policy.status === "error") {
+			throw this.policyError(request.provider, "invalid-config", `${policy.path}: ${policy.message}`);
+		}
+		const providerPolicy = policy.policy.providers[request.provider];
+		if (!providerPolicy) return { status: "unconfigured" };
+
+		let waiting = false;
+		let deadline: number | undefined;
+		let lastEvaluation: CandidateEvaluation[] = [];
+		try {
+			for (;;) {
+				throwIfAborted(request.signal);
+				const observedWakeVersion = this.wakeVersion;
+				const result = await this.options.source.candidates(request);
+				throwIfAborted(request.signal);
+				if (!result.supported) {
+					throw this.policyError(
+						request.provider,
+						"unsupported",
+						"Subscription usage is not supported for this request.",
+					);
+				}
+				if (result.candidates.length === 0) {
+					throw this.policyError(request.provider, "unknown", "No subscription accounts are available.");
+				}
+
+				const now = this.now();
+				lastEvaluation = evaluateCandidates(
+					policy.policy.providers[request.provider],
+					result.candidates,
+					now,
+					this.freshMs,
+				);
+				const capacities = evaluateCapacities(providerPolicy, lastEvaluation);
+				const selection = this.selectCandidate(request.provider, lastEvaluation, capacities);
+				if (selection) {
+					if (waiting) this.adjustWaiting(request.provider, -1);
+					const leaseId = this.nextLeaseId++;
+					this.leases.set(leaseId, { provider: request.provider, poolId: selection.snapshot.poolId });
+					this.adjustRunning(request.provider, selection.snapshot.poolId, 1);
+					return { status: "admitted", credentialId: selection.snapshot.credentialId, leaseId };
+				}
+
+				if (!waiting) {
+					deadline = now + providerPolicy.maxWaitMs;
+					if (providerPolicy.maxWaitMs === 0) throw this.denialError(request.provider, lastEvaluation, now);
+					waiting = true;
+					this.adjustWaiting(request.provider, 1);
+				}
+				if (this.now() >= deadline!) throw this.denialError(request.provider, lastEvaluation, this.now());
+				if (observedWakeVersion !== this.wakeVersion) continue;
+				const waitMs = Math.max(1, Math.min(this.pollMs, deadline! - this.now()));
+				await this.waitForChange(waitMs, request.signal, observedWakeVersion);
+			}
+		} finally {
+			if (waiting) this.adjustWaiting(request.provider, -1);
+		}
+	}
+
+	async release(leaseId: number): Promise<void> {
+		const lease = this.leases.get(leaseId);
+		if (lease) {
+			this.leases.delete(leaseId);
+			this.adjustRunning(lease.provider, lease.poolId, -1);
+		}
+		this.wakeWaiters();
+	}
+
+	async status(): Promise<string> {
+		const { policy } = this.options;
+		const lines = [`Subscription usage policy: ${sanitizeText(policy.path)}`];
+		if (policy.status === "disabled") {
+			lines.push("The policy file is absent; subscription usage limits are disabled.");
+			lines.push("Example: configure providers.<provider>.maxInFlight and windows.5h/windows.7d in this file.");
+			lines.push("Restart OMP after editing.");
+			return lines.join("\n");
+		}
+		if (policy.status === "error") {
+			lines.push(`Configuration error: ${sanitizeText(policy.message)}`);
+			lines.push("Restart OMP after editing.");
+			return lines.join("\n");
+		}
+
+		const policyDocument: SubscriptionUsagePolicy = policy.policy;
+		for (const [providerId, providerPolicy] of Object.entries(policyDocument.providers)) {
+			const provider = sanitizeText(providerId);
+			const running = this.runningByProvider.get(providerId) ?? 0;
+			const waiting = this.waitingByProvider.get(providerId) ?? 0;
+			let candidates: readonly SubscriptionCandidateSnapshot[] = [];
+			let sourceStatus: "ready" | "unsupported" | "error" = "ready";
+			try {
+				const result = await this.options.source.candidates({ provider: providerId });
+				if (!result.supported) sourceStatus = "unsupported";
+				else candidates = result.candidates;
+			} catch {
+				sourceStatus = "error";
+			}
+			const evaluated = evaluateCandidates(providerPolicy, candidates, this.now(), this.freshMs);
+			const capacities = evaluateCapacities(providerPolicy, evaluated);
+			lines.push(
+				`Provider ${provider}: running=${running}/${capacities.providerCeiling} (max=${providerPolicy.maxInFlight}), waiting=${waiting}`,
+			);
+			if (sourceStatus !== "ready") {
+				lines.push(
+					`  candidates: ${sourceStatus === "unsupported" ? "unsupported route" : "source unavailable"} (unknown)`,
+				);
+				continue;
+			}
+			if (evaluated.length === 0) {
+				lines.push("  candidates: none (unknown)");
+				continue;
+			}
+			for (const candidate of evaluated) {
+				const state = this.candidateStatus(providerId, candidate, capacities);
+				const identity = candidate.snapshot.identity
+					? ` identity=${JSON.stringify(sanitizeText(candidate.snapshot.identity))}`
+					: "";
+				lines.push(`  credential:${candidate.snapshot.credentialId} ${state}${identity}`);
+				for (const meter of candidate.meters) {
+					const label = sanitizeText(meter.meter.label || meter.meter.id);
+					lines.push(
+						`    ${displayWindow(meter.window, meter.meter.durationMs)} ${label}: used=${formatPercent(meter.usedPercent)}, soft=${formatPercent(meter.softPercent)}, hard=${formatPercent(meter.hardPercent)}, reset=${formatCountdown(meter.resetsInMs)}`,
+					);
+				}
+			}
+		}
+		lines.push("Restart OMP after editing.");
+		return lines.join("\n");
+	}
+
+	private selectCandidate(
+		provider: string,
+		candidates: CandidateEvaluation[],
+		capacities: CapacityEvaluation,
+	): CandidateEvaluation | undefined {
+		const providerRunning = this.runningByProvider.get(provider) ?? 0;
+		if (providerRunning >= capacities.providerCeiling) return undefined;
+		const available = candidates.filter(candidate => {
+			if (!candidate.valid || candidate.blocked || candidate.hardCapped) return false;
+			const poolCapacity = capacities.poolCapacities.get(candidate.snapshot.poolId) ?? 0;
+			const poolRunning = this.runningByPool.get(provider)?.get(candidate.snapshot.poolId) ?? 0;
+			return poolRunning < poolCapacity && poolRunning < candidate.ownCeiling;
+		});
+		const preferred = available.filter(candidate => candidate.underSoft);
+		const choices = preferred.length > 0 ? preferred : available;
+		choices.sort((left, right) => {
+			const headroom = (right.headroom ?? Number.NEGATIVE_INFINITY) - (left.headroom ?? Number.NEGATIVE_INFINITY);
+			if (headroom !== 0) return headroom;
+			const remaining = (right.remaining ?? Number.NEGATIVE_INFINITY) - (left.remaining ?? Number.NEGATIVE_INFINITY);
+			if (remaining !== 0) return remaining;
+			return left.snapshot.order - right.snapshot.order;
+		});
+		return choices[0];
+	}
+
+	private candidateStatus(provider: string, candidate: CandidateEvaluation, capacities: CapacityEvaluation): string {
+		if (candidate.blocked) return "cooldown";
+		if (!candidate.valid) return "unknown";
+		if (candidate.hardCapped) return "hard capped";
+		const running = this.runningByProvider.get(provider) ?? 0;
+		const poolRunning = this.runningByPool.get(provider)?.get(candidate.snapshot.poolId) ?? 0;
+		const poolCapacity = capacities.poolCapacities.get(candidate.snapshot.poolId) ?? 0;
+		if (running >= capacities.providerCeiling || poolRunning >= poolCapacity || poolRunning >= candidate.ownCeiling) {
+			return "capacity";
+		}
+		return candidate.underSoft ? "preferred" : "soft fallback";
+	}
+
+	private denialError(provider: string, candidates: CandidateEvaluation[], now: number): SubscriptionUsagePolicyError {
+		let reason: SubscriptionUsagePolicyReason = "unknown";
+		if (candidates.some(candidate => candidate.blocked)) {
+			reason = "cooldown";
+		} else if (
+			candidates.some(
+				candidate =>
+					candidate.hasExhaustedMeter ||
+					(candidate.valid && candidate.headroom !== undefined && candidate.headroom <= 0),
+			)
+		) {
+			reason = "hard-cap";
+		} else if (candidates.some(candidate => candidate.valid)) {
+			reason = "capacity";
+		}
+		const nextObservationAt =
+			reason === "cooldown"
+				? candidates.reduce<number | undefined>((next, candidate) => {
+						const blockedUntil = candidate.snapshot.blockedUntil;
+						if (!isFiniteNumber(blockedUntil) || blockedUntil <= now) return next;
+						return next === undefined ? blockedUntil : Math.min(next, blockedUntil);
+					}, undefined)
+				: undefined;
+		return this.policyError(provider, reason, undefined, nextObservationAt);
+	}
+
+	private policyError(
+		provider: string,
+		reason: SubscriptionUsagePolicyReason,
+		detail?: string,
+		nextObservationAt?: number,
+	): SubscriptionUsagePolicyError {
+		return new SubscriptionUsagePolicyError(provider, reason, {
+			detail,
+			nextObservationAt,
+		});
+	}
+
+	private adjustRunning(provider: string, poolId: string, amount: number): void {
+		const providerCount = (this.runningByProvider.get(provider) ?? 0) + amount;
+		if (providerCount === 0) this.runningByProvider.delete(provider);
+		else this.runningByProvider.set(provider, providerCount);
+		let pools = this.runningByPool.get(provider);
+		if (!pools) {
+			pools = new Map();
+			this.runningByPool.set(provider, pools);
+		}
+		const poolCount = (pools.get(poolId) ?? 0) + amount;
+		if (poolCount === 0) pools.delete(poolId);
+		else pools.set(poolId, poolCount);
+		if (pools.size === 0) this.runningByPool.delete(provider);
+	}
+
+	private adjustWaiting(provider: string, amount: number): void {
+		const count = (this.waitingByProvider.get(provider) ?? 0) + amount;
+		if (count <= 0) this.waitingByProvider.delete(provider);
+		else this.waitingByProvider.set(provider, count);
+	}
+
+	private wakeWaiters(): void {
+		this.wakeVersion++;
+		for (const wake of this.waiters) wake();
+	}
+
+	private waitForChange(ms: number, signal: AbortSignal | undefined, observedWakeVersion: number): Promise<void> {
+		if (signal?.aborted)
+			return Promise.reject(
+				signal ? abortReason(signal) : new DOMException("The operation was aborted", "AbortError"),
+			);
+		if (observedWakeVersion !== this.wakeVersion) return Promise.resolve();
+		return new Promise((resolve, reject) => {
+			let settled = false;
+			const timerAbort = new AbortController();
+			const cleanup = () => {
+				this.waiters.delete(onWake);
+				signal?.removeEventListener("abort", onAbort);
+				timerAbort.abort();
+			};
+			const finish = (error?: unknown) => {
+				if (settled) return;
+				settled = true;
+				cleanup();
+				if (error !== undefined) reject(error);
+				else resolve();
+			};
+			const onWake = () => finish();
+			const onAbort = () => finish(abortReason(signal!));
+			this.waiters.add(onWake);
+			signal?.addEventListener("abort", onAbort, { once: true });
+			if (signal?.aborted) {
+				finish(abortReason(signal));
+				return;
+			}
+			void this.sleep(ms, timerAbort.signal).then(
+				() => finish(),
+				error => {
+					if (!timerAbort.signal.aborted) finish(error);
+				},
+			);
+		});
+	}
+}
