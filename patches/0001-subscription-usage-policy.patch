--- /dev/null
+++ b/packages/coding-agent/src/task/subscription-usage.ts
@@ -0,0 +1,304 @@
+import * as fs from "node:fs";
+import * as path from "node:path";
+
+export type CurveMode = "linear" | "step" | "smooth";
+
+export interface CurvePoint {
+	/** Minutes remaining until reset, strictly descending in a curve. */
+	remainingMinutes: number;
+	/** Hard background cap, percent of the whole window already consumed. */
+	hardPercent: number;
+	/** Optional soft cap; soft <= hard. */
+	softPercent?: number;
+}
+
+export interface WindowCurve {
+	mode: CurveMode;
+	points: CurvePoint[];
+}
+
+export interface AccountWindowOverrides {
+	fiveHour?: WindowCurve;
+	weekly?: WindowCurve;
+}
+
+export interface AccountPolicyOverride {
+	windows: AccountWindowOverrides;
+}
+
+export interface ProviderPolicy {
+	maxInFlight: number;
+	maxWaitMs: number;
+	fiveHour: WindowCurve;
+	weekly: WindowCurve;
+	accounts: Record<string, AccountPolicyOverride>;
+}
+
+export interface SubscriptionUsagePolicy {
+	version: 1;
+	providers: Record<string, ProviderPolicy>;
+}
+
+export type PolicyLoad =
+	| { status: "disabled"; path: string }
+	| { status: "error"; path: string; message: string }
+	| { status: "ready"; path: string; policy: SubscriptionUsagePolicy };
+
+export const SUBSCRIPTION_USAGE_FILENAME = "subscription-usage.yml";
+
+const DURATION = /^(0|[1-9][0-9]*)(m|h|d)$/;
+const WINDOWS = ["5h", "7d"] as const;
+const CURVE_MODES: readonly CurveMode[] = ["linear", "step", "smooth"];
+
+class PolicyValidationError extends Error {
+	constructor(
+		readonly field: string,
+		message: string,
+	) {
+		super(message);
+	}
+}
+
+function invalid(field: string, message: string): never {
+	throw new PolicyValidationError(field, message);
+}
+
+function record(value: unknown, field: string): Record<string, unknown> {
+	if (typeof value !== "object" || value === null || Array.isArray(value)) invalid(field, "must be a mapping");
+	return value as Record<string, unknown>;
+}
+
+function onlyKeys(value: Record<string, unknown>, allowed: readonly string[], field: string): void {
+	for (const key of Object.keys(value)) {
+		if (!allowed.includes(key)) invalid(`${field}.${key}`, "is not a supported field");
+	}
+}
+
+function duration(value: unknown, field: string, unitMs: number): number {
+	if (typeof value !== "string") invalid(field, "must be a duration string");
+	const match = DURATION.exec(value);
+	if (!match) invalid(field, "must match ^(0|[1-9][0-9]*)(m|h|d)$");
+	const amount = Number(match[1]);
+	const multiplier = match[2] === "m" ? 1 : match[2] === "h" ? 60 : 1440;
+	const result = amount * multiplier * unitMs;
+	if (!Number.isSafeInteger(result)) invalid(field, "duration is too large");
+	return result;
+}
+
+function percentage(value: unknown, field: string): number {
+	if (typeof value !== "number" || !Number.isFinite(value) || value < 0 || value > 100) {
+		invalid(field, "must be a finite number from 0 to 100");
+	}
+	return value;
+}
+
+function parseCurve(value: unknown, field: string, expectedWindowMinutes?: number): WindowCurve {
+	const input = record(value, field);
+	onlyKeys(input, ["mode", "points"], field);
+	if (typeof input.mode !== "string" || !CURVE_MODES.includes(input.mode as CurveMode)) {
+		invalid(`${field}.mode`, "must be linear, step, or smooth");
+	}
+	if (!Array.isArray(input.points)) invalid(`${field}.points`, "must be an array");
+	if (input.points.length < 2) invalid(`${field}.points`, "must contain at least two points");
+
+	const points: CurvePoint[] = [];
+	let hasSoft: boolean | undefined;
+	for (let index = 0; index < input.points.length; index++) {
+		const pointField = `${field}.points[${index}]`;
+		const rawPoint: unknown = input.points[index];
+		if (!Array.isArray(rawPoint) || (rawPoint.length !== 2 && rawPoint.length !== 3)) {
+			invalid(pointField, "must be [duration, hardPercent, softPercent?]");
+		}
+		const remainingMinutes = duration(rawPoint[0], `${pointField}[0]`, 1);
+		const hardPercent = percentage(rawPoint[1], `${pointField}[1]`);
+		const pointHasSoft = rawPoint.length === 3;
+		if (hasSoft !== undefined && hasSoft !== pointHasSoft) {
+			invalid(pointField, "all points must either specify softPercent or omit it");
+		}
+		hasSoft = pointHasSoft;
+
+		let softPercent: number | undefined;
+		if (pointHasSoft) {
+			softPercent = percentage(rawPoint[2], `${pointField}[2]`);
+			if (softPercent > hardPercent) invalid(`${pointField}[2]`, "must not exceed hardPercent");
+		}
+
+		const previous = points[index - 1];
+		if (previous) {
+			if (remainingMinutes >= previous.remainingMinutes) {
+				invalid(`${pointField}[0]`, "durations must be strictly descending and unique");
+			}
+			if (hardPercent < previous.hardPercent) {
+				invalid(`${pointField}[1]`, "hardPercent must be nondecreasing from first to last");
+			}
+			if (softPercent !== undefined && previous.softPercent !== undefined && softPercent < previous.softPercent) {
+				invalid(`${pointField}[2]`, "softPercent must be nondecreasing from first to last");
+			}
+		}
+		points.push(
+			softPercent === undefined ? { remainingMinutes, hardPercent } : { remainingMinutes, hardPercent, softPercent },
+		);
+	}
+
+	if (expectedWindowMinutes !== undefined && points[0].remainingMinutes !== expectedWindowMinutes) {
+		invalid(`${field}.points[0][0]`, `must be ${expectedWindowMinutes} minutes for this window`);
+	}
+	if (points[points.length - 1].remainingMinutes !== 0) {
+		invalid(`${field}.points[${points.length - 1}][0]`, "last duration must be 0 minutes");
+	}
+
+	return { mode: input.mode as CurveMode, points };
+}
+
+function parseProvider(value: unknown, field: string): ProviderPolicy {
+	const input = record(value, field);
+	onlyKeys(input, ["maxInFlight", "maxWait", "windows", "accounts"], field);
+	if (!Number.isSafeInteger(input.maxInFlight) || (input.maxInFlight as number) <= 0) {
+		invalid(`${field}.maxInFlight`, "must be a positive safe integer");
+	}
+	const maxWaitMs = input.maxWait === undefined ? 5 * 60_000 : duration(input.maxWait, `${field}.maxWait`, 60_000);
+	const windows = record(input.windows, `${field}.windows`);
+	onlyKeys(windows, WINDOWS, `${field}.windows`);
+	for (const name of WINDOWS) {
+		if (!(name in windows)) invalid(`${field}.windows.${name}`, "is required");
+	}
+
+	const accounts: Record<string, AccountPolicyOverride> = {};
+	if (input.accounts !== undefined) {
+		const rawAccounts = record(input.accounts, `${field}.accounts`);
+		for (const [key, value] of Object.entries(rawAccounts)) {
+			const accountField = `${field}.accounts.${key}`;
+			if (!/^credential:[1-9][0-9]*$/.test(key)) {
+				invalid(accountField, "key must match ^credential:[1-9][0-9]*$");
+			}
+			const account = record(value, accountField);
+			onlyKeys(account, ["windows"], accountField);
+			const overrideWindows = record(account.windows, `${accountField}.windows`);
+			onlyKeys(overrideWindows, WINDOWS, `${accountField}.windows`);
+			if (Object.keys(overrideWindows).length === 0) {
+				invalid(`${accountField}.windows`, "must override at least one window");
+			}
+			const parsedWindows: AccountWindowOverrides = {};
+			if ("5h" in overrideWindows) {
+				parsedWindows.fiveHour = parseCurve(overrideWindows["5h"], `${accountField}.windows.5h`, 300);
+			}
+			if ("7d" in overrideWindows) {
+				parsedWindows.weekly = parseCurve(overrideWindows["7d"], `${accountField}.windows.7d`, 10080);
+			}
+			accounts[key] = { windows: parsedWindows };
+		}
+	}
+
+	return {
+		maxInFlight: input.maxInFlight as number,
+		maxWaitMs,
+		fiveHour: parseCurve(windows["5h"], `${field}.windows.5h`, 300),
+		weekly: parseCurve(windows["7d"], `${field}.windows.7d`, 10080),
+		accounts,
+	};
+}
+
+function parsePolicy(value: unknown): SubscriptionUsagePolicy {
+	const input = record(value, "document");
+	onlyKeys(input, ["version", "providers"], "document");
+	if (input.version !== 1) invalid("version", "must be 1");
+	const rawProviders = record(input.providers, "providers");
+	const providers: Record<string, ProviderPolicy> = {};
+	for (const [id, provider] of Object.entries(rawProviders)) {
+		providers[id] = parseProvider(provider, `providers.${id}`);
+	}
+	return { version: 1, providers };
+}
+
+function errorMessage(error: unknown): string {
+	return error instanceof Error ? error.message : String(error);
+}
+
+function loadError(filePath: string, field: string, message: string): PolicyLoad {
+	return { status: "error", path: filePath, message: `${filePath}: ${field}: ${message}` };
+}
+
+/** Reads <agentDir>/subscription-usage.yml once per call. Only ENOENT means disabled. */
+export function loadSubscriptionUsagePolicy(agentDir: string): PolicyLoad {
+	const filePath = path.join(agentDir, SUBSCRIPTION_USAGE_FILENAME);
+	let text: string;
+	try {
+		text = fs.readFileSync(filePath, "utf8");
+	} catch (error) {
+		if (typeof error === "object" && error !== null && "code" in error && error.code === "ENOENT") {
+			return { status: "disabled", path: filePath };
+		}
+		return loadError(filePath, "file", errorMessage(error));
+	}
+
+	let parsed: unknown;
+	try {
+		parsed = Bun.YAML.parse(text) as unknown;
+	} catch (error) {
+		return loadError(filePath, "yaml", `invalid YAML: ${errorMessage(error)}`);
+	}
+
+	try {
+		return { status: "ready", path: filePath, policy: parsePolicy(parsed) };
+	} catch (error) {
+		if (error instanceof PolicyValidationError) return loadError(filePath, error.field, error.message);
+		return loadError(filePath, "document", `invalid configuration: ${errorMessage(error)}`);
+	}
+}
+
+export function evaluateCurve(
+	curve: WindowCurve,
+	remainingMinutes: number,
+): { hardPercent: number; softPercent?: number } | undefined {
+	const points = curve.points;
+	if (Number.isNaN(remainingMinutes) || points.length < 2) return undefined;
+	const first = points[0];
+	const last = points[points.length - 1];
+	if (!first || !last || !Number.isFinite(first.remainingMinutes)) return undefined;
+
+	const remaining = Math.max(0, Math.min(remainingMinutes, first.remainingMinutes));
+	if (remaining >= first.remainingMinutes) {
+		return first.softPercent === undefined
+			? { hardPercent: first.hardPercent }
+			: { hardPercent: first.hardPercent, softPercent: first.softPercent };
+	}
+	if (remaining <= 0) {
+		return last.softPercent === undefined
+			? { hardPercent: last.hardPercent }
+			: { hardPercent: last.hardPercent, softPercent: last.softPercent };
+	}
+
+	for (let index = 1; index < points.length; index++) {
+		const current = points[index];
+		const previous = points[index - 1];
+		if (remaining === current.remainingMinutes) {
+			return current.softPercent === undefined
+				? { hardPercent: current.hardPercent }
+				: { hardPercent: current.hardPercent, softPercent: current.softPercent };
+		}
+		if (remaining > current.remainingMinutes) {
+			if (curve.mode === "step") {
+				return previous.softPercent === undefined
+					? { hardPercent: previous.hardPercent }
+					: { hardPercent: previous.hardPercent, softPercent: previous.softPercent };
+			}
+			if (curve.mode !== "linear" && curve.mode !== "smooth") return undefined;
+			const t = (previous.remainingMinutes - remaining) / (previous.remainingMinutes - current.remainingMinutes);
+			const amount = curve.mode === "smooth" ? t * t * (3 - 2 * t) : t;
+			const hardPercent = previous.hardPercent + (current.hardPercent - previous.hardPercent) * amount;
+			if (previous.softPercent !== undefined && current.softPercent !== undefined) {
+				return {
+					hardPercent,
+					softPercent: previous.softPercent + (current.softPercent - previous.softPercent) * amount,
+				};
+			}
+			return { hardPercent };
+		}
+	}
+	return undefined;
+}
+
+/** Resolve the effective curve for a durable credential row id. */
+export function curveFor(policy: ProviderPolicy, window: "fiveHour" | "weekly", credentialId: number): WindowCurve {
+	return policy.accounts[`credential:${credentialId}`]?.windows[window] ?? policy[window];
+}
