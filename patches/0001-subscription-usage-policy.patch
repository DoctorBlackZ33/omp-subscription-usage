+		// 65% and 90% used => capacities 2 and 1; the pool counts once as 1.
+		// Pool B reports 50% used => capacity 2. Provider ceiling = 3.
+		const source = sourceFor([
+			candidate({ credentialId: 1, poolId: "pool-a", fiveHourUsed: 0.65, weeklyUsed: 0.65 }),
+			candidate({ credentialId: 2, poolId: "pool-a", order: 1, fiveHourUsed: 0.9, weeklyUsed: 0.9 }),
+			candidate({ credentialId: 3, poolId: "pool-b", order: 2, fiveHourUsed: 0.5, weeklyUsed: 0.5 }),
+		]);
+		const controller = new SubscriptionUsageController({
+			agentDir: "/agent",
+			policy,
+			source,
+			now: () => NOW,
+			sleep: signalAwareSleep(),
+		});
+
+		expect((await controller.admit({ provider: "test-provider" })).status).toBe("admitted");
+		expect((await controller.admit({ provider: "test-provider" })).status).toBe("admitted");
+		expect((await controller.admit({ provider: "test-provider" })).status).toBe("admitted");
+		await expect(controller.admit({ provider: "test-provider" })).rejects.toBeInstanceOf(
+			SubscriptionUsagePolicyError,
+		);
+	});
+});
