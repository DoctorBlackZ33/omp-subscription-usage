+++ b/packages/ai/test/subscription-usage-auth.test.ts
@@ -0,0 +1,110 @@
+import { afterEach, beforeEach, describe, expect, test, vi } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { AuthStorage, SqliteAuthCredentialStore } from "@oh-my-pi/pi-ai/auth-storage";
+import * as oauthUtils from "@oh-my-pi/pi-ai/registry/oauth";
+import type { UsageProvider, UsageReport } from "@oh-my-pi/pi-ai/usage";
+
+const PROVIDER = "unit-subscription-usage";
+
+function oauthCredential(suffix: string) {
+	return {
+		type: "oauth" as const,
+		access: `access-${suffix}`,
+		refresh: `refresh-${suffix}`,
+		expires: Date.now() + 60 * 60_000,
+		accountId: `acc-${suffix}`,
+		email: `${suffix}@example.com`,
+	};
+}
+
+function report(now: number): UsageReport {
+	return {
+		provider: PROVIDER,
+		fetchedAt: now,
+		limits: [
+			{
+				id: "5h",
+				label: "5 Hour",
+				scope: { provider: PROVIDER, shared: true },
+				window: { id: "5h", label: "5 Hour", durationMs: 300 * 60_000, resetsAt: now + 2 * 60 * 60_000 },
+				amount: { usedFraction: 0.2, unit: "percent" },
+			},
+			{
+				id: "7d",
+				label: "7 Day",
+				scope: { provider: PROVIDER, shared: true },
+				window: { id: "7d", label: "7 Day", durationMs: 10080 * 60_000, resetsAt: now + 3 * 24 * 60 * 60_000 },
+				amount: { usedFraction: 0.1, unit: "percent" },
+			},
+		],
+	};
+}
+
+describe("AuthStorage subscription candidates", () => {
+	let tempDir = "";
+	let stores: SqliteAuthCredentialStore[] = [];
+	let storage: AuthStorage;
+
+	beforeEach(async () => {
+		tempDir = await fs.mkdtemp(path.join(os.tmpdir(), "pi-ai-sub-usage-"));
+		const store = await SqliteAuthCredentialStore.open(path.join(tempDir, "agent.db"));
+		stores = [store];
+		storage = new AuthStorage(store);
+		vi.spyOn(oauthUtils, "getOAuthApiKey").mockImplementation(async (provider, credentials) => {
+			const credential = credentials[provider];
+			return credential ? { newCredentials: credential, apiKey: credential.access } : null;
+		});
+		const usageProvider: UsageProvider = {
+			id: PROVIDER,
+			fetchUsage: async () => report(Date.now()),
+		};
+		storage.usage.setProvider(PROVIDER, usageProvider);
+	});
+
+	afterEach(async () => {
+		vi.restoreAllMocks();
+		for (const store of stores) store.close();
+		await fs.rm(tempDir, { recursive: true, force: true });
+	});
+
+	test("returns per-credential raw meters in native order without choosing a key", async () => {
+		await storage.credentials.set(PROVIDER, [oauthCredential("a"), oauthCredential("b")]);
+		const accounts = storage.oauth.accounts(PROVIDER);
+		const result = await storage.keys.subscriptionCandidates(PROVIDER, undefined, { modelId: "model-1" });
+		expect(result.supported).toBe(true);
+		expect(result.candidates.map(candidate => candidate.credentialId)).toEqual(
+			accounts.map(account => account.credentialId),
+		);
+		expect(result.candidates.map(candidate => candidate.order)).toEqual([0, 1]);
+		for (const candidate of result.candidates) {
+			expect(candidate.fetchedAt).toBeGreaterThan(0);
+			expect(candidate.meters.map(meter => meter.durationMs)).toEqual([300 * 60_000, 10080 * 60_000]);
+			expect(candidate.meters[0]?.usedFraction).toBe(0.2);
+			expect(candidate.meters[1]?.usedFraction).toBe(0.1);
+		}
+		// Listing is not selecting: no session pin was recorded.
+		expect(storage.sessions.pin(PROVIDER, "s", accounts[0]!.credentialId)).toBe(true);
+	});
+
+	test("narrows candidates to an explicit session pin", async () => {
+		await storage.credentials.set(PROVIDER, [oauthCredential("a"), oauthCredential("b")]);
+		const accounts = storage.oauth.accounts(PROVIDER);
+		expect(storage.sessions.pin(PROVIDER, "session-pinned", accounts[1]!.credentialId)).toBe(true);
+		const result = await storage.keys.subscriptionCandidates(PROVIDER, "session-pinned", { modelId: "model-1" });
+		expect(result.candidates.map(candidate => candidate.credentialId)).toEqual([accounts[1]!.credentialId]);
+	});
+
+	test("pins the admitted row for request resolution", async () => {
+		await storage.credentials.set(PROVIDER, [oauthCredential("a"), oauthCredential("b")]);
+		const accounts = storage.oauth.accounts(PROVIDER);
+		const pinned = await storage.keys.getWithCredential(PROVIDER, undefined, {
+			preferredCredentialId: accounts[1]!.credentialId,
+			modelId: "model-1",
+			recordAffinity: false,
+		});
+		expect(pinned?.apiKey).toBe("access-b");
+		expect(pinned?.credentialId).toBe(accounts[1]!.credentialId);
+	});
+});
