+function wrap(base: ApiKeyResolver): ApiKeyResolver {
+	const wrapped = withSubscriptionUsagePolicy(model => base, {
+		agentDir: AGENT_DIR,
+		sessionId: () => "session-1",
+	});
+	return wrapped(model()) as ApiKeyResolver;
+}
+
+describe("subscription usage wiring", () => {
+	afterEach(() => resetSubscriptionUsageControllersForTesting());
+
+	it("pins the admitted credential and releases its lease exactly once", async () => {
+		const released: number[] = [];
+		setSubscriptionUsageControllerForTesting(AGENT_DIR, {
+			admit: async () => ({ status: "admitted", credentialId: 42, leaseId: 7 }),
+			release: async leaseId => {
+				released.push(leaseId);
+			},
+			status: async () => "",
+		});
+		const contexts: ApiKeyResolveContext[] = [];
+		const resolver = wrap(ctx => {
+			contexts.push(ctx);
+			return { apiKey: "bearer-42", credentialId: 42 };
+		});
+		const resolved = await resolver({ lastChance: false, error: undefined });
+		expect(contexts[0]?.preferredCredentialId).toBe(42);
+		expect(typeof resolved === "object" && resolved.credentialId).toBe(42);
+		const admission = typeof resolved === "object" ? resolved.providerAttemptAdmission : undefined;
+		expect(admission).toBeDefined();
+		const release = await admission!.reserve(42);
+		await release();
+		await release();
+		expect(released).toEqual([7]);
+	});
+
+	it("refuses a dispatched credential that differs from the admitted row", async () => {
+		const released: number[] = [];
+		setSubscriptionUsageControllerForTesting(AGENT_DIR, {
+			admit: async () => ({ status: "admitted", credentialId: 42, leaseId: 9 }),
+			release: async leaseId => {
+				released.push(leaseId);
+			},
+			status: async () => "",
+		});
+		const resolver = wrap(() => ({ apiKey: "bearer-7", credentialId: 7 }));
+		await expect(resolver({ lastChance: false, error: undefined })).rejects.toBeInstanceOf(
+			SubscriptionUsagePolicyError,
+		);
+		expect(released).toEqual([9]);
+	});
+
+	it("passes through unresolvable static keys and unconfigured providers", async () => {
+		setSubscriptionUsageControllerForTesting(AGENT_DIR, {
+			admit: async () => ({ status: "unconfigured" }),
+			release: async () => {},
+			status: async () => "",
+		});
+		const wrapped = withSubscriptionUsagePolicy(model => "static-key" satisfies ApiKey, {
+			agentDir: AGENT_DIR,
+			sessionId: () => "session-1",
+		});
+		expect(wrapped(model())).toBe("static-key");
+	});
+});
diff --git a/packages/coding-agent/test/subscription-usage.test.ts b/packages/coding-agent/test/subscription-usage.test.ts
new file mode 100644
